<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Social App</title>

  <script src="https://telegram.org/js/telegram-web-app.js"></script>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: #f2f4f7;
      display: flex;
      justify-content: center;
    }

    .container {
      width: 100%;
      max-width: 500px;
      padding: 25px 18px;
    }

    .card {
      background: white;
      padding: 25px;
      border-radius: 20px;
      text-align: center;
      box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    h1 {
      margin-top: 0;
    }

    button {
      width: 100%;
      padding: 15px;
      margin-top: 15px;
      border: none;
      border-radius: 12px;
      font-size: 16px;
      font-weight: bold;
    }

    .facebook {
      background: #1877f2;
      color: white;
    }

    .close {
      background: #e9edf2;
      color: #222;
    }
  </style>
</head>

<body>

<div class="container">
  <div class="card">

    <h1>My Social App</h1>

    <p id="welcome">
      Welcome to my Telegram Mini App
    </p>

    <button class="facebook" onclick="openFacebook()">
      Open Facebook
    </button>

    <button class="close" onclick="closeApp()">
      Close
    </button>

  </div>
</div>

<script>

  const tg = window.Telegram.WebApp;

  tg.ready();
  tg.expand();

  const user = tg.initDataUnsafe.user;

  if (user) {
    document.getElementById("welcome").innerText =
      "Welcome, " + user.first_name;
  }

  function openFacebook() {
    window.open(
      "https://www.facebook.com/",
      "_blank"
    );
  }

  function closeApp() {
    tg.close();
  }

</script>

</body>
</html>
